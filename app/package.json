{
  "name": "cara-app",
  "version": "0.0.0",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "postinstall": "node fetch-model.mjs",
    "prestart": "tailwindcss -i dev/dev-ui.src.css -o dev/dev-ui.css --minify",
    "dev:css": "tailwindcss -i dev/dev-ui.src.css -o dev/dev-ui.css --watch"
