      "**/*",
      "!dev.html",
      "!dev/**"
    ]
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "basecoat-css": "^1.1.0",
    "electron": "^33.0.0",
    "tailwindcss": "^4.3.3"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.14",
    "@tensorflow/tfjs": "^4.22.0"
  }
}
